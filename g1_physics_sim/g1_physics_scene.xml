<mujoco model="g1_physics_scene">
  <compiler angle="radian" meshdir="../unitree_g1_vibes/RL-shenanigans/unitree_mujoco/unitree_robots/g1/meshes" />
  
  <include file="../unitree_g1_vibes/RL-shenanigans/unitree_mujoco/unitree_robots/g1/g1_29dof.xml"/>

  <statistic center="0 0 0.75" extent="2.0"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light pos="2 2 3.0" dir="-1 -1 -1" directional="false" diffuse="0.4 0.4 0.4"/>
    
    <!-- Realistic high-friction ground plane for stable footing -->
    <geom name="ground_floor" size="10 10 0.05" type="plane" material="groundplane" friction="1.2 0.01 0.001" condim="4"/>

    <!-- 3D Cartesian target marker for arm teleoperation / manipulation tasks -->
    <body name="target_marker" pos="0.30 0.20 0.90" mocap="true">
      <site name="target_sphere" type="sphere" size="0.025" rgba="0.1 0.85 0.3 0.75"/>
      <site name="target_axis_x" type="cylinder" size="0.004 0.04" pos="0.04 0 0" quat="0.7071 0 0.7071 0" rgba="1 0 0 0.8"/>
      <site name="target_axis_y" type="cylinder" size="0.004 0.04" pos="0 0.04 0" quat="0.7071 0.7071 0 0" rgba="0 1 0 0.8"/>
      <site name="target_axis_z" type="cylinder" size="0.004 0.04" pos="0 0 0.04" rgba="0 0 1 0.8"/>
    </body>
  </worldbody>
</mujoco>
